---
import TerminalLayout from "../layouts/TerminalLayout.astro";
---

<TerminalLayout>
  <div class="terminal-line hero-line hidden" id="hero-line">
    <span class="output" id="name-output"></span>
  </div>

  <div class="terminal-line hidden" id="description-line">
    <span class="output-secondary" id="description-output"></span>
  </div>

  <div class="terminal-line hidden" id="about-line">
    <span class="output-accent">About</span>
  </div>

  <div class="terminal-line hidden" id="about-text-line">
    <span class="output-secondary" id="about-output"></span>
  </div>

  <div class="terminal-line hidden" id="command-line-2">
    <span class="prompt">$</span>
    <span class="command" id="command-2"></span>
    <span class="cursor" id="cursor-2">_</span>
  </div>

  <div id="projects-output-initial"></div>

  <div
    class="terminal-line interactive-line hidden"
    id="interactive-line"
    style="display: none;"
  >
    <span class="prompt">$</span>
    <input
      type="text"
      class="command-input"
      id="command-input"
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"
      spellcheck="false"
      aria-label="Terminal command input"
      tabindex="0"
    />
    <!-- <span class="cursor blink" id="cursor-final">_</span> -->
  </div>
  <div id="autocomplete-suggestions" class="autocomplete-suggestions"></div>
  <div id="command-output"></div>
</TerminalLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const isMobile = window.innerWidth <= 768;
    const hasVisited = sessionStorage.getItem("hasVisited");
    const shouldAnimate = false;
    const terminalBody = document.querySelector(
      ".terminal-body"
    ) as HTMLElement;

    const lsCommand = "ls";

    const outputs = {
      name: { element: "name-output", text: "Alejandro Alvarez", delay: 1000 },
      description: {
        element: "description-output",
        text: "Software developer",
        delay: 1500,
      },
      about: {
        element: "about-output",
        text: "I’m a software developer focused on building modern web products with deep expertise in blockchain and artificial intelligence.",
        delay: 2500,
      },
      projects: [
        {
          name: "portfolio",
          desc: "Personal portfolio with interactive terminal",
          details:
            "Minimalist landing page built with Astro. Interactive retro-technical terminal with custom commands. Technologies: Astro, TypeScript, vanilla CSS.",
        },
        {
          name: "vaquita",
          desc: "Savings app with gamification",
          details:
            "Savings app with gamification with visual state system. Technologies: Next.js 14, TypeScript, Tailwind CSS, React Three Fiber, Web3 tooling.",
        },
      ],
    };

    const typeWriter = (
      element: string,
      text: string,
      speed: number = 50,
      callback?: () => void
    ) => {
      const el = document.getElementById(element);
      if (!el) return;

      // Render text directly without animation
      el.textContent = text;
      if (callback) {
        callback();
      }
    };

    const hideCursor = (id: string) => {
      const cursor = document.getElementById(id);
      if (cursor) {
        cursor.style.display = "none";
      }
    };

    const showLine = (id: string) => {
      const line = document.getElementById(id);
      if (!line) return;

      line.classList.remove("hidden");
      if (id === "interactive-line") {
        line.style.display = "";
        const input = line.querySelector("#command-input");
        if (input instanceof HTMLInputElement) {
          input.disabled = false;
          input.readOnly = false;
          input.removeAttribute("readonly");
          input.removeAttribute("disabled");
          input.setAttribute("tabindex", "0");
          input.removeAttribute("aria-hidden");
          input.setAttribute("inputmode", "text");
          input.setAttribute("enterkeyhint", "go");
          input.setAttribute("autocapitalize", "off");
          if (!isMobile) {
            input.focus();
          }
        }
      }
    };

    if (shouldAnimate) {
      // On mobile, hide cursors from the start
      if (isMobile) {
        hideCursor("cursor-2");
      }

      // Sequence 1: name -> description
      const startSequence1 = () => {
        showLine("hero-line");
        typeWriter("name-output", outputs.name.text, 100, () => {
          setTimeout(() => {
            showLine("description-line");
            typeWriter("description-output", outputs.description.text, 30, () => {
              // When sequence 1 ends, start sequence 2
              setTimeout(() => {
                startSequence2();
              }, 500);
            });
          }, 300);
        });
      };

      // Sequence 2: show About directly, then ls -> Projects -> list -> input
      const startSequence2 = () => {
        // Show About without a command
        setTimeout(() => {
          showLine("about-line");
          setTimeout(() => {
            showLine("about-text-line");
            typeWriter("about-output", outputs.about.text, 20, () => {
              // When About finishes, start sequence with ls
              setTimeout(() => {
                showLine("command-line-2");
                typeWriter("command-2", lsCommand, 80, () => {
                  setTimeout(() => {
                    hideCursor("cursor-2");
                    // Apply styles to the initial command
                    const cmd2El = document.getElementById("command-2");
                    if (cmd2El) {
                      cmd2El.style.color = "var(--command-color)";
                      cmd2El.style.fontWeight = "500";
                    }
                    const cmd2Line = document.getElementById("command-line-2");
                    if (cmd2Line) {
                      cmd2Line.classList.add("has-output");
                    }
                    setTimeout(() => {
                      const projectsContainer = document.getElementById(
                        "projects-output-initial"
                      );
                      if (projectsContainer) {
                        outputs.projects.forEach((project) => {
                          const line = document.createElement("div");
                          line.className = "command-output-line";
                          const projectLink = document.createElement("a");
                          projectLink.href = `/projects/${project.name.toLowerCase()}`;
                          projectLink.style.cssText =
                            "color: var(--accent); font-weight: 500; text-decoration: none; cursor: pointer;";
                          projectLink.textContent = project.name;
                          const descSpan = document.createElement("span");
                          descSpan.style.cssText =
                            "color: var(--text-secondary);";
                          descSpan.textContent = ` — ${project.desc}`;
                          line.appendChild(projectLink);
                          line.appendChild(descSpan);
                          projectsContainer.appendChild(line);
                        });

                        // Mostrar input también en móvil (enfoca solo desktop)
                        showLine("interactive-line");

                        // Ensure scroll is at the end
                        if (terminalBody) {
                          setTimeout(() => {
                            terminalBody.scrollTop = terminalBody.scrollHeight;
                          }, 100);
                        }
                      }
                    }, 300);
                  }, 300);
                });
              }, 500);
            });
          }, 300);
        }, 500);
      };

      // Start the first sequence after a small initial delay
      setTimeout(() => {
        // Ensure scroll starts at the top
        if (terminalBody) {
          terminalBody.scrollTop = 0;
        }
        startSequence1();
      }, 500);
    } else {
      // On mobile, hide cursors from the start
      if (isMobile) {
        hideCursor("cursor-2");
      }

      // Show everything instantly
      showLine("hero-line");
      const nameEl = document.getElementById("name-output");
      if (nameEl) nameEl.textContent = outputs.name.text;

      showLine("description-line");
      const descEl = document.getElementById("description-output");
      if (descEl) descEl.textContent = outputs.description.text;

      showLine("about-line");
      showLine("about-text-line");
      const aboutEl = document.getElementById("about-output");
      if (aboutEl) aboutEl.textContent = outputs.about.text;

      showLine("command-line-2");
      const cmd2El = document.getElementById("command-2");
      if (cmd2El) {
        cmd2El.textContent = lsCommand;
        cmd2El.style.color = "var(--command-color)";
        cmd2El.style.fontWeight = "500";
      }
      hideCursor("cursor-2");
      const cmd2Line = document.getElementById("command-line-2");
      if (cmd2Line) {
        cmd2Line.classList.add("has-output");
      }

      const projectsContainer = document.getElementById(
        "projects-output-initial"
      );
      if (projectsContainer) {
        outputs.projects.forEach((project) => {
          const line = document.createElement("div");
          line.className = "command-output-line";
          const projectLink = document.createElement("a");
          projectLink.href = `/projects/${project.name.toLowerCase()}`;
          projectLink.style.cssText =
            "color: var(--accent); font-weight: 500; text-decoration: none; cursor: pointer;";
          projectLink.textContent = project.name;
          const descSpan = document.createElement("span");
          descSpan.style.cssText = "color: var(--text-secondary);";
          descSpan.textContent = ` — ${project.desc}`;
          line.appendChild(projectLink);
          line.appendChild(descSpan);
          projectsContainer.appendChild(line);
        });
      }

      showLine("interactive-line");
    }

    // Interactive terminal

    const commandInput = document.getElementById(
      "command-input"
    ) as HTMLInputElement;
    const commandOutput = document.getElementById("command-output");

    if (!commandInput || !commandOutput || !terminalBody) return;

    let commandHistory: string[] = [];
    let historyIndex = -1;
    let currentCommand = "";
    let autocompleteIndex = -1;
    let currentSuggestions: string[] = [];

    const projectsData = [
      {
        name: "portfolio",
        desc: "Personal portfolio with interactive terminal",
        details:
          "Minimalist landing page built with Astro. Interactive retro-technical terminal with custom commands. Technologies: Astro, TypeScript, vanilla CSS.",
      },
      {
        name: "vaquita",
        desc: "Savings app with gamification",
        details:
          "Savings app with gamification with visual state system. Technologies: Next.js 14, TypeScript, Tailwind CSS, React Three Fiber, Web3 tooling.",
      },
    ];


    const openProject = (args?: string) => {
      if (!args || !args.trim()) {
        return "Usage: vim <project-name>\nExample: vim portfolio";
      }
      const projectName = args.trim().toLowerCase();
      const project = projectsData.find(
        (p) => p.name.toLowerCase() === projectName
      );
      if (project) {
        // Redirect to the project page (lowercase slug)
        setTimeout(() => {
          window.location.href = `/projects/${project.name.toLowerCase()}`;
        }, 300);
        return `Opening ${project.name} with vim...`;
      }
      return `Project "${args}" not found.\nUse "ls" to see the list.`;
    };


    const commands: Record<string, (args?: string) => string> = {
      help: () => {
        return `Available commands:

  • help              Show this help message
  • clear             Clear the console
  • whoami            Show user information
  • ls                List all projects
  • vim <name>        Open project

Type a command and press Enter to execute it.`;
      },
      clear: () => {
        // Remove all dynamic lines (commands and results) except the input and initial content
        const interactiveLine = commandInput.parentElement as HTMLElement;
        const projectsInitial = document.getElementById(
          "projects-output-initial"
        );
        const commandLine2 = document.getElementById("command-line-2");
        const allLines = terminalBody.querySelectorAll(
          ".terminal-line, .command-output-line"
        );
        allLines.forEach((line) => {
          // Do not remove the interactive input or the initial lines
          const isInitialContent =
            line.id === "command-line-2" ||
            line.id === "command-line-1" ||
            line.id?.startsWith("hero-") ||
            line.id?.startsWith("description-") ||
            line.id?.startsWith("about-") ||
            (commandLine2 && commandLine2.contains(line)) ||
            (projectsInitial && projectsInitial.contains(line));

          if (!line.contains(commandInput) && !isInitialContent) {
            line.remove();
          }
        });
        // Clear command history
        commandHistory = [];
        historyIndex = -1;
        return "";
      },
      whoami: () => {
        return "SOCIAL_LINKS";
      },
      ls: () => {
        return projectsData.map((p) => `${p.name} — ${p.desc}`).join("\n");
      },
      vim: openProject,
      cat: openProject,
    };

    const executeCommand = (cmd: string) => {
      const trimmedCmd = cmd.trim();

      if (!trimmedCmd) {
        return "";
      }

      // Add to history
      if (
        commandHistory.length === 0 ||
        commandHistory[commandHistory.length - 1] !== cmd
      ) {
        commandHistory.push(cmd);
        if (commandHistory.length > 50) {
          commandHistory.shift();
        }
      }
      historyIndex = commandHistory.length;

      // Parse command and arguments
      const parts = trimmedCmd.split(/\s+/);
      const commandName = parts[0].toLowerCase();
      const args = parts.slice(1).join(" ");

      // Execute command
      if (commands[commandName]) {
        return commands[commandName](args);
      } else {
        return `Command not found: ${parts[0]}. Type "help" to see available commands.`;
      }
    };

    const addOutputLine = (
      text: string,
      isError = false,
      insertAfter?: HTMLElement
    ) => {
      if (!text) return;

      // Split by line breaks and create separate elements
      const lines = text.split("\n");
      lines.forEach((lineText) => {
        const line = document.createElement("div");
        line.className = `command-output-line ${isError ? "error" : ""}`;

        // Format lines with colors for readability
        if (lineText.trim().startsWith("•")) {
          // Help command lines - format: • command    description
          const match = lineText.match(/^(\s*•\s+)(\S+)(\s{2,})(.+)$/);
          if (match) {
            line.innerHTML = `<span style="color: var(--accent);">${match[1]}</span><span style="color: var(--command-color); font-weight: 500;">${match[2]}</span><span style="color: var(--text-secondary);">${match[3]}${match[4]}</span>`;
          } else {
            line.textContent = lineText;
          }
        } else if (
          lineText.includes("Available commands:") ||
          lineText.includes("Type a command")
        ) {
          // Titles and key messages
          line.style.color = "var(--accent)";
          line.style.fontWeight = "500";
          line.textContent = lineText;
        } else if (
          lineText.trim().startsWith("Usage:") ||
          lineText.trim().startsWith("Example:")
        ) {
          // Usage messages
          const colonIndex = lineText.indexOf(":");
          if (colonIndex > 0) {
            line.innerHTML = `<span style="color: var(--accent); font-weight: 500;">${lineText.substring(0, colonIndex + 1)}</span><span style="color: var(--text-secondary);">${lineText.substring(colonIndex + 1)}</span>`;
          } else {
            line.textContent = lineText;
          }
        } else if (lineText.includes(" — ")) {
          // ls format: name — description
          const parts = lineText.split(" — ");
          if (parts.length === 2) {
            const projectName = parts[0].trim();
            const project = projectsData.find((p) => p.name === projectName);
            if (project) {
              const projectLink = document.createElement("a");
              projectLink.href = `/projects/${project.name.toLowerCase()}`;
              projectLink.style.cssText =
                "color: var(--accent); font-weight: 500; text-decoration: none; cursor: pointer;";
              projectLink.textContent = projectName;
              const descSpan = document.createElement("span");
              descSpan.style.cssText = "color: var(--text-secondary);";
              descSpan.textContent = ` — ${parts[1]}`;
              line.appendChild(projectLink);
              line.appendChild(descSpan);
            } else {
              line.innerHTML = `<span style="color: var(--accent); font-weight: 500;">${parts[0]}</span><span style="color: var(--text-secondary);"> — ${parts[1]}</span>`;
            }
          } else {
            line.textContent = lineText;
          }
        } else if (
          lineText.includes("Entering") ||
          lineText.includes("Opening")
        ) {
          // Action messages
          const colonIndex = lineText.indexOf(":");
          if (colonIndex > 0) {
            line.innerHTML = `<span style="color: var(--accent); font-weight: 500;">${lineText.substring(0, colonIndex + 1)}</span><span style="color: var(--text-secondary);">${lineText.substring(colonIndex + 1)}</span>`;
          } else {
            line.style.color = "var(--accent)";
            line.textContent = lineText;
          }
        } else if (
          lineText.includes("not found") ||
          lineText.includes("Command not found")
        ) {
          // Error messages
          line.style.color = "#ff6b6b";
          line.textContent = lineText;
        } else {
          line.textContent = lineText;
        }

        if (insertAfter) {
          // Insert after the specified element
          insertAfter.insertAdjacentElement("afterend", line);
          insertAfter = line; // Update reference for the next line
        } else {
          // If no reference, append to the end of the output
          commandOutput.appendChild(line);
        }
      });

      // Scroll to the end
      terminalBody.scrollTop = terminalBody.scrollHeight;
    };

    const createCommandLine = (cmd: string) => {
      const line = document.createElement("div");
      line.className = "terminal-line";
      const prompt = document.createElement("span");
      prompt.className = "prompt";
      prompt.textContent = "$";
      prompt.style.color = "var(--prompt-color)";
      const command = document.createElement("span");
      command.className = "command";
      command.textContent = cmd;
      command.style.color = "var(--command-color)";
      command.style.fontWeight = "500";
      line.appendChild(prompt);
      line.appendChild(command);
      return line;
    };

    const addSocialLinks = (insertAfter: HTMLElement) => {
      const socialLinks = [
        { name: "linkedin", url: "https://www.linkedin.com/in/aleregex/" },
        { name: "twitter", url: "https://x.com/aleregex" },
        { name: "github", url: "https://github.com/aleregex" },
      ];

      socialLinks.forEach((link) => {
        const line = document.createElement("div");
        line.className = "command-output-line";

        const linkElement = document.createElement("a");
        linkElement.href = link.url;
        linkElement.target = "_blank";
        linkElement.rel = "noopener noreferrer";
        linkElement.style.cssText =
          "color: var(--accent); font-weight: 500; text-decoration: none; cursor: pointer; display: flex; align-items: center; gap: 0.75rem; transition: opacity 0.2s ease;";
        linkElement.addEventListener("mouseenter", () => {
          linkElement.style.opacity = "0.8";
        });
        linkElement.addEventListener("mouseleave", () => {
          linkElement.style.opacity = "1";
        });

        const nameSpan = document.createElement("span");
        nameSpan.style.cssText =
          "color: var(--accent); font-weight: 500; min-width: 80px;";
        nameSpan.textContent = link.name;

        const urlSpan = document.createElement("span");
        urlSpan.style.cssText = "color: var(--text-secondary);";
        urlSpan.textContent = link.url;

        linkElement.appendChild(nameSpan);
        linkElement.appendChild(urlSpan);
        line.appendChild(linkElement);

        insertAfter.insertAdjacentElement("afterend", line);
        insertAfter = line;
      });

      // Scroll to the end
      terminalBody.scrollTop = terminalBody.scrollHeight;
    };

    const autocompleteSuggestions = document.getElementById(
      "autocomplete-suggestions"
    );

    const showAutocomplete = (query: string) => {
      if (!autocompleteSuggestions) return;

      const parts = query.trim().split(/\s+/);
      if (parts[0]?.toLowerCase() === "vim" && parts.length >= 2) {
        const searchTerm = parts.slice(1).join(" ").toLowerCase();
        const matches = projectsData
          .filter((p) => p.name.toLowerCase().startsWith(searchTerm))
          .map((p) => p.name);

        if (matches.length > 0) {
          currentSuggestions = matches;
          autocompleteSuggestions.innerHTML = "";
          matches.forEach((match, idx) => {
            const suggestion = document.createElement("div");
            suggestion.className = `autocomplete-suggestion ${idx === 0 ? "selected" : ""}`;
            suggestion.innerHTML = `<strong>vim ${match}</strong>`;
            suggestion.addEventListener("click", () => {
              commandInput.value = `vim ${match}`;
              hideAutocomplete();
              commandInput.focus();
            });
            autocompleteSuggestions.appendChild(suggestion);
          });
          autocompleteSuggestions.style.display = "block";
          autocompleteIndex = 0;
        } else {
          hideAutocomplete();
        }
      } else {
        hideAutocomplete();
      }
    };

    const hideAutocomplete = () => {
      if (autocompleteSuggestions) {
        autocompleteSuggestions.style.display = "none";
        autocompleteSuggestions.innerHTML = "";
        currentSuggestions = [];
        autocompleteIndex = -1;
      }
    };

    const updateAutocompleteSelection = () => {
      if (!autocompleteSuggestions) return;
      const suggestions = autocompleteSuggestions.querySelectorAll(
        ".autocomplete-suggestion"
      );
      suggestions.forEach((suggestion, idx) => {
        if (idx === autocompleteIndex) {
          suggestion.classList.add("selected");
          suggestion.scrollIntoView({ block: "nearest" });
        } else {
          suggestion.classList.remove("selected");
        }
      });
    };

    commandInput.addEventListener("input", () => {
      currentCommand = commandInput.value;
      showAutocomplete(commandInput.value);
    });

    commandInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();

        // If autocomplete is active and a suggestion is selected
        if (autocompleteIndex >= 0 && currentSuggestions.length > 0) {
          const selectedProject = currentSuggestions[autocompleteIndex];
          commandInput.value = `vim ${selectedProject}`;
          hideAutocomplete();
        }

        const cmd = commandInput.value.trim();

        if (cmd) {
          // Create line with the executed command
          const cmdLine = createCommandLine(" " + cmd);
          const interactiveLine = commandInput.parentElement as HTMLElement;
          terminalBody.insertBefore(cmdLine, interactiveLine);

          // Execute command and show the result right after the command
          const result = executeCommand(cmd);
          if (result) {
            cmdLine.classList.add("has-output");
            // Small delay to ensure the style applies
            setTimeout(() => {
              if (result === "SOCIAL_LINKS") {
                addSocialLinks(cmdLine);
              } else {
                addOutputLine(result, false, cmdLine);
              }
            }, 10);
          }

          // Clear input
          commandInput.value = "";
          currentCommand = "";
          hideAutocomplete();

          // Scroll to the end
          setTimeout(() => {
            terminalBody.scrollTop = terminalBody.scrollHeight;
          }, 10);
        }
      } else if (e.key === "Tab") {
        e.preventDefault();
        // Autocomplete with the first suggestion
        if (autocompleteIndex >= 0 && currentSuggestions.length > 0) {
          const selectedProject = currentSuggestions[autocompleteIndex];
          const parts = commandInput.value.trim().split(/\s+/);
          if (parts[0]?.toLowerCase() === "vim") {
            commandInput.value = `vim ${selectedProject}`;
            hideAutocomplete();
          }
        }
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        if (
          autocompleteSuggestions?.style.display === "block" &&
          currentSuggestions.length > 0
        ) {
          // Navigate autocomplete
          autocompleteIndex =
            autocompleteIndex > 0
              ? autocompleteIndex - 1
              : currentSuggestions.length - 1;
          updateAutocompleteSelection();
        } else if (commandHistory.length > 0) {
          if (historyIndex > 0) {
            historyIndex--;
          }
          const historyCmd = commandHistory[historyIndex];
          commandInput.value = historyCmd !== undefined ? historyCmd : "";
        }
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        if (
          autocompleteSuggestions?.style.display === "block" &&
          currentSuggestions.length > 0
        ) {
          // Navigate autocomplete
          autocompleteIndex =
            autocompleteIndex < currentSuggestions.length - 1
              ? autocompleteIndex + 1
              : 0;
          updateAutocompleteSelection();
        } else if (historyIndex < commandHistory.length - 1) {
          historyIndex++;
          const historyCmd = commandHistory[historyIndex];
          commandInput.value = historyCmd !== undefined ? historyCmd : "";
        } else {
          historyIndex = commandHistory.length;
          commandInput.value = currentCommand;
        }
      } else if (e.key === "Escape") {
        hideAutocomplete();
      } else {
        currentCommand = commandInput.value;
      }
    });

    // Autofocus when the terminal is clicked
    terminalBody.addEventListener("click", () => {
      commandInput.focus();
    });

    // Initial focus after the animation (solo desktop para evitar teclado inmediato)
    if (!shouldAnimate && !isMobile) {
      setTimeout(() => {
        commandInput.focus();
      }, 100);
    }
  });
</script>
