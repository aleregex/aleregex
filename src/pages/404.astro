---
import Layout from '../layouts/Layout.astro';
---

<Layout showFooter={false}>
	<main>
		<div class="terminal">
			<div class="terminal-header">
				<span class="terminal-dot"></span>
				<span class="terminal-dot"></span>
				<span class="terminal-dot"></span>
				<span class="terminal-title">terminal</span>
			</div>
			
			<div class="terminal-body">
				<div class="terminal-line">
					<span class="output error-title">404: Not found</span>
				</div>
				
				<div class="terminal-line">
					<span class="output-secondary">PATH: {Astro.url.pathname}</span>
				</div>
				
				<div class="terminal-line command-line">
					<a href="/" class="back-button">
						<span class="prompt">$</span>
						<span class="command">cd</span>
						<span class="command-arg">$HOME</span>
					</a>
				</div>
			</div>
		</div>
	</main>
</Layout>

<style>
	:root {
		--bg-color: #0a0a0a;
		--terminal-bg: #0d1117;
		--text-primary: #c9d1d9;
		--text-secondary: #8b949e;
		--accent: #7dd3a0;
		--accent-hover: #9ee4c0;
		--prompt-color: #58a6ff;
		--command-color: #f0883e;
		--border-color: #30363d;
		--error-color: #c084fc;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		overflow: hidden;
		width: 100%;
		height: 100%;
		max-width: 100vw;
		max-height: 100vh;
	}

	body {
		background-color: var(--bg-color);
		color: var(--text-primary);
		font-family: 'Pixel Operator Mono', 'Courier New', monospace;
		line-height: 1.6;
		height: 100vh;
		overflow: hidden;
		width: 100%;
		max-width: 100vw;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
	}

	main {
		width: min(900px, calc(100% - 2rem));
		height: 700px;
		max-width: min(900px, calc(100% - 2rem));
		max-height: 700px;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		flex-shrink: 0;
	}

	.terminal {
		background-color: var(--terminal-bg);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
		width: 100%;
		height: 600px;
		max-width: 100%;
		max-height: 600px;
		display: flex;
		flex-direction: column;
		flex-shrink: 0;
	}

	.terminal-header {
		background-color: #161b22;
		padding: clamp(0.5rem, 2vw, 0.75rem) clamp(0.75rem, 2vw, 1rem);
		display: flex;
		align-items: center;
		gap: clamp(0.25rem, 1vw, 0.5rem);
		border-bottom: 1px solid var(--border-color);
		flex-wrap: nowrap;
	}

	.terminal-dot {
		width: clamp(8px, 2vw, 12px);
		height: clamp(8px, 2vw, 12px);
		border-radius: 50%;
		background-color: #484f58;
		flex-shrink: 0;
	}

	.terminal-dot:nth-child(1) {
		background-color: #ff5f56;
	}

	.terminal-dot:nth-child(2) {
		background-color: #ffbd2e;
	}

	.terminal-dot:nth-child(3) {
		background-color: #27c93f;
	}

	.terminal-title {
		margin-left: auto;
		font-size: clamp(0.6rem, 2vw, 0.75rem);
		color: var(--text-secondary);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.terminal-body {
		padding: clamp(1rem, 3vw, 1.5rem) clamp(0.75rem, 3vw, 1.5rem);
		font-size: clamp(0.85rem, 2.5vw, 1rem);
		width: 100%;
		overflow-x: hidden;
		overflow-y: auto;
		box-sizing: border-box;
		scroll-behavior: smooth;
		flex: 1;
		min-height: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		align-items: flex-start;
	}

	.terminal-line {
		margin-bottom: clamp(0.25rem, 1vw, 0.5rem);
		display: flex;
		align-items: baseline;
		gap: clamp(0.25rem, 1vw, 0.5rem);
		min-height: 1.5em;
		width: 100%;
		word-wrap: break-word;
		overflow-wrap: break-word;
		box-sizing: border-box;
		max-width: 100%;
	}

	.prompt {
		color: var(--prompt-color);
		font-weight: 500;
		user-select: none;
		flex-shrink: 0;
	}

	.output {
		color: var(--text-primary);
		font-size: clamp(1.25rem, 5vw + 0.5rem, 2.5rem);
		font-weight: 400;
		letter-spacing: -0.02em;
		word-wrap: break-word;
		overflow-wrap: break-word;
		max-width: 100%;
		line-height: 1.2;
	}

	.output-secondary {
		color: var(--text-secondary);
		word-wrap: break-word;
		overflow-wrap: break-word;
		max-width: 100%;
		line-height: 1.5;
	}

	.error-title {
		color: var(--accent);
		font-size: clamp(1.5rem, 5vw + 0.5rem, 2.5rem);
		font-weight: 400;
		letter-spacing: -0.02em;
		line-height: 1.2;
		margin-bottom: 0;
	}

	.command-line {
		margin-top: clamp(0.75rem, 2vw, 1rem);
		opacity: 0.6;
	}

	.back-button {
		display: flex;
		align-items: baseline;
		gap: 0.25rem;
		text-decoration: none;
		color: var(--text-primary);
		font-size: clamp(0.85rem, 2.5vw, 1rem);
		font-family: 'Pixel Operator Mono', 'Courier New', monospace;
		transition: all 0.2s ease;
		cursor: pointer;
		line-height: 1.5;
	}

	.back-button:hover {
		opacity: 1;
		transform: translateX(4px);
	}

	.command-line:hover {
		opacity: 1;
	}

	.back-button .prompt,
	.back-button .command,
	.back-button .command-arg {
		line-height: inherit;
		margin: 0;
		padding: 0;
        color: var(--text-primary);
	}

	.back-button .prompt {
		color: var(--prompt-color);
		font-weight: 500;
		flex-shrink: 0;
	}

	.back-button .command {
		color: var(--command-color);
		font-weight: 500;
	}

	.back-button .command-arg {
		color: var(--accent);
		font-weight: 500;
	}

	@media (max-width: 768px) {
		body {
			padding: 1rem;
		}

		main {
			width: calc(100% - 2rem);
			height: calc(100vh - 2rem);
			max-width: calc(100% - 2rem);
			max-height: calc(100vh - 2rem);
		}

		.terminal {
			width: 100%;
			height: calc(100% - 4rem);
			max-width: 100%;
			max-height: calc(100% - 4rem);
		}

		.terminal-line {
			flex-wrap: wrap;
		}
	}

	@media (max-width: 480px) {
		.terminal-line {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>

