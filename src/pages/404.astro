---
import TerminalLayout from '../layouts/TerminalLayout.astro';
---

<TerminalLayout>
	<div class="terminal-line">
		<span class="output error-title">404: Not found</span>
	</div>
	
	<div class="terminal-line command-line">
		<a href="/" class="back-button">
			<span class="prompt">$</span>
			<span class="command">cd</span>
			<span class="command-arg">$HOME</span>
		</a>
	</div>
</TerminalLayout>

<style>

	.error-title {
		color: var(--accent);
		font-size: clamp(1.5rem, 5vw + 0.5rem, 2.5rem);
		font-weight: 400;
		letter-spacing: -0.02em;
		line-height: 1.2;
		margin-bottom: 0;
	}

	.command-line {
		margin-top: clamp(0.75rem, 2vw, 1rem);
		opacity: 0.6;
	}

	.back-button {
		display: flex;
		align-items: baseline;
		gap: 0.25rem;
		text-decoration: none;
		color: var(--text-primary);
		font-size: clamp(0.85rem, 2.5vw, 1rem);
		font-family: 'Pixel Operator Mono', 'Courier New', monospace;
		transition: all 0.2s ease;
		cursor: pointer;
		line-height: 1.5;
	}

	.back-button:hover {
		opacity: 1;
		transform: translateX(4px);
	}

	.command-line:hover {
		opacity: 1;
	}

	.back-button .prompt,
	.back-button .command,
	.back-button .command-arg {
		line-height: inherit;
		margin: 0;
		padding: 0;
        color: var(--text-primary);
	}

	.back-button .prompt {
		color: var(--prompt-color);
		font-weight: 500;
		flex-shrink: 0;
	}

	.back-button .command {
		color: var(--command-color);
		font-weight: 500;
	}

	.back-button .command-arg {
		color: var(--accent);
		font-weight: 500;
	}

	@media (max-width: 768px) {
		.error-title {
			font-size: 2.5rem;
		}

		.output-secondary {
			font-size: 1.25rem;
		}

		.back-button {
			font-size: 1.25rem;
		}
	}

	@media (max-width: 480px) {
		.error-title {
			font-size: 2.75rem;
		}

		.output-secondary {
			font-size: 1.3rem;
		}

		.back-button {
			font-size: 1.3rem;
		}
	}
</style>

