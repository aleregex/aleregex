---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';

export async function getStaticPaths() {
	return Object.keys(projects).map((project) => ({
		params: { project }
	}));
}

const { project } = Astro.params;
const projectData = projects[project as keyof typeof projects];

if (!projectData) {
	return Astro.redirect('/404');
}
---

<Layout>
	<main>
		<div class="project-container">
			<nav class="back-nav">
				<a href="/" class="back-link">
					← Volver al inicio
				</a>
			</nav>
			
			<article class="project-content">
				<header class="project-header">
					<h1 class="project-title">{projectData.name}</h1>
					<p class="project-subtitle">{projectData.desc}</p>
				</header>
				
				<div class="project-body">
					{'url' in projectData && projectData.url && (
						<div class="project-section">
							<a href={projectData.url} target="_blank" rel="noopener noreferrer" class="project-link">
								<span>Visitar sitio web</span>
								<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d="M6 3H3C2.44772 3 2 3.44772 2 4V13C2 13.5523 2.44772 14 3 14H12C12.5523 14 13 13.5523 13 13V10M10 2H14M14 2V6M14 2L6 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
								</svg>
							</a>
						</div>
					)}
					<div class="project-section">
						<h2 class="section-title">Descripción</h2>
						<p class="project-details">{projectData.details}</p>
					</div>
				</div>
			</article>
		</div>
	</main>
</Layout>

<style>
	:root {
		--bg-color: #ffffff;
		--bg-secondary: #f8f9fa;
		--text-primary: #1a1a1a;
		--text-secondary: #6b7280;
		--accent: #2563eb;
		--accent-hover: #1d4ed8;
		--border-color: #e5e7eb;
		--shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
		--shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg-color: #0f172a;
			--bg-secondary: #1e293b;
			--text-primary: #f1f5f9;
			--text-secondary: #94a3b8;
			--accent: #60a5fa;
			--accent-hover: #3b82f6;
			--border-color: #334155;
			--shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.3), 0 1px 2px 0 rgba(0, 0, 0, 0.2);
			--shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.3), 0 4px 6px -2px rgba(0, 0, 0, 0.2);
		}
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		background-color: var(--bg-color);
		color: var(--text-primary);
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
		line-height: 1.6;
		min-height: 100vh;
		padding: 0;
		margin: 0;
		transition: background-color 0.3s ease, color 0.3s ease;
	}

	main {
		max-width: min(900px, 90%);
		width: 100%;
		margin: 0 auto;
		padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 4vw, 2rem);
		min-height: 100vh;
		box-sizing: border-box;
	}

	.project-container {
		width: 100%;
		animation: fadeIn 0.5s ease-in;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.back-nav {
		margin-bottom: clamp(2rem, 5vw, 3rem);
	}

	.back-link {
		color: var(--text-secondary);
		text-decoration: none;
		font-size: clamp(0.875rem, 2vw, 1rem);
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		transition: all 0.2s ease;
		padding: 0.5rem 1rem;
		border-radius: 0.5rem;
		font-weight: 500;
	}

	.back-link:hover {
		color: var(--accent);
		background-color: var(--bg-secondary);
	}

	.project-content {
		width: 100%;
	}

	.project-header {
		margin-bottom: clamp(3rem, 6vw, 4rem);
		padding-bottom: clamp(2rem, 4vw, 3rem);
		border-bottom: 2px solid var(--border-color);
	}

	.project-title {
		color: var(--text-primary);
		font-size: clamp(2.5rem, 7vw, 4rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		margin-bottom: clamp(1rem, 3vw, 1.5rem);
		line-height: 1.1;
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
	}

	.project-subtitle {
		color: var(--text-secondary);
		font-size: clamp(1.125rem, 3vw, 1.5rem);
		line-height: 1.6;
		font-weight: 400;
		max-width: 700px;
	}

	.project-body {
		width: 100%;
	}

	.project-section {
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	.section-title {
		color: var(--text-primary);
		font-size: clamp(1.5rem, 4vw, 2rem);
		font-weight: 600;
		margin-bottom: clamp(1rem, 2vw, 1.5rem);
		letter-spacing: -0.02em;
	}

	.project-details {
		color: var(--text-primary);
		font-size: clamp(1rem, 2.5vw, 1.125rem);
		line-height: 1.8;
		white-space: pre-wrap;
		word-wrap: break-word;
		overflow-wrap: break-word;
		max-width: 800px;
	}

	.project-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--accent);
		text-decoration: none;
		font-size: clamp(1rem, 2.5vw, 1.125rem);
		font-weight: 500;
		padding: 0.75rem 1.5rem;
		border: 2px solid var(--accent);
		border-radius: 0.5rem;
		transition: all 0.2s ease;
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	.project-link:hover {
		background-color: var(--accent);
		color: var(--bg-color);
		transform: translateY(-2px);
		box-shadow: var(--shadow-lg);
	}

	.project-link svg {
		transition: transform 0.2s ease;
	}

	.project-link:hover svg {
		transform: translate(2px, -2px);
	}

	@media (max-width: 768px) {
		main {
			padding: clamp(1.5rem, 4vw, 2rem) clamp(1rem, 3vw, 1.5rem);
		}

		.project-header {
			margin-bottom: clamp(2rem, 4vw, 2.5rem);
			padding-bottom: clamp(1.5rem, 3vw, 2rem);
		}

		.project-section {
			margin-bottom: clamp(1.5rem, 3vw, 2rem);
		}
	}
</style>

