---
interface Props {
	showFooter?: boolean;
}

const { showFooter = true } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Software developer · Full Stack · Blockchain · AI" />
		<title>aleregex</title>
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Pixel+Operator+Mono:wght@400&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot />
		{showFooter && (
			<footer class="global-footer" id="github-footer">
				<div class="footer-command">
					<span class="prompt">$</span> cat github.txt
				</div>
				<div class="footer-links" id="footer-links" style="display: none;">
					<a href="https://github.com/aleregex" target="_blank" rel="noopener noreferrer" class="social-link">
						<span class="link-name">github</span>
						<span class="link-url">https://github.com/aleregex</span>
					</a>
					<a href="https://linkedin.com/in/aleregex" target="_blank" rel="noopener noreferrer" class="social-link">
						<span class="link-name">linkedin</span>
						<span class="link-url">https://linkedin.com/in/aleregex</span>
					</a>
					<a href="https://twitter.com/aleregex" target="_blank" rel="noopener noreferrer" class="social-link">
						<span class="link-name">twitter</span>
						<span class="link-url">https://twitter.com/aleregex</span>
					</a>
				</div>
			</footer>
		)}
	</body>
</html>

<style is:global>
	html, body {
		overflow: hidden;
		width: 100%;
		height: 100%;
		max-width: 100vw;
		max-height: 100vh;
		margin: 0;
		padding: 0;
	}

	.global-footer {
		position: fixed;
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		margin-top: 1rem;
		padding: 1rem;
		border-top: 1px solid rgba(125, 211, 160, 0.2);
		text-align: center;
		width: min(900px, calc(100% - 2rem));
		max-width: min(900px, calc(100% - 2rem));
		background: rgba(10, 10, 10, 0.7);
		backdrop-filter: blur(20px) saturate(180%);
		-webkit-backdrop-filter: blur(20px) saturate(180%);
		z-index: 1000;
	}

	.footer-command {
		color: #8b949e;
		font-family: 'Pixel Operator Mono', 'Courier New', monospace;
		font-size: clamp(0.75rem, 2vw, 0.9rem);
		cursor: pointer;
		transition: color 0.2s ease;
		display: inline-flex;
		align-items: center;
		gap: clamp(0.25rem, 1vw, 0.5rem);
		word-wrap: break-word;
		overflow-wrap: break-word;
		max-width: 100%;
	}

	.footer-command:hover {
		color: #7dd3a0;
	}

	.global-footer .prompt {
		color: #58a6ff;
	}

	.footer-links {
		margin-top: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		align-items: flex-start;
		text-align: left;
	}

	.social-link {
		color: #7dd3a0;
		text-decoration: none;
		font-family: 'Pixel Operator Mono', 'Courier New', monospace;
		font-size: clamp(0.75rem, 2vw, 0.9rem);
		transition: opacity 0.2s ease;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: 100%;
	}

	.social-link:hover {
		opacity: 0.8;
	}

	.link-name {
		color: #7dd3a0;
		font-weight: 500;
		min-width: 80px;
	}

	.link-url {
		color: #8b949e;
	}
</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const footer = document.getElementById('github-footer');
		const footerCommand = footer?.querySelector('.footer-command');
		const footerLinks = document.getElementById('footer-links');
		
		if (footerCommand && footerLinks) {
			footerCommand.addEventListener('click', () => {
				const isVisible = footerLinks.style.display !== 'none';
				footerLinks.style.display = isVisible ? 'none' : 'flex';
			});
		}
	});
</script>
